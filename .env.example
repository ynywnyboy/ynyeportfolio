# Copy to .env.local and fill in from Supabase -> Project Settings -> API (or "API Keys")
# Only the PUBLIC key goes here (publishable / anon). NEVER put the service_role or secret key in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
